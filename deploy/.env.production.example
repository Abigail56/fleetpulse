# Copy to deploy/.env.production, which git ignores, and fill in every value.
# Generate each password and secret with: openssl rand -hex 32

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=
FLEETPULSE_APP_DB_PASSWORD=
REDIS_PASSWORD=
# Signs sessions. Changing it signs everyone out.
FLEETPULSE_JWT_SECRET=

# A real mail provider. Production refuses to start without STARTTLS.
FLEETPULSE_SMTP_HOST=
FLEETPULSE_SMTP_PORT=587
FLEETPULSE_SMTP_USERNAME=
FLEETPULSE_SMTP_PASSWORD=
FLEETPULSE_EMAIL_FROM=FleetPulse <no-reply@example.com>
FLEETPULSE_CONTACT_INBOX_EMAIL=

# Any private S3-compatible bucket. Create it first, and keep public access blocked.
FLEETPULSE_STORAGE_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
FLEETPULSE_STORAGE_BUCKET=
FLEETPULSE_STORAGE_REGION=eu-west-1
FLEETPULSE_STORAGE_ACCESS_KEY=
FLEETPULSE_STORAGE_SECRET_KEY=

# Optional.
# FLEETPULSE_GOOGLE_CLIENT_ID=
# FLEETPULSE_GOOGLE_CLIENT_SECRET=
# FLEETPULSE_PAYSTACK_SECRET_KEY=
# FLEETPULSE_BILLING_CURRENCY=USD
# Only after a real payment has been tested.
# FLEETPULSE_BILLING_ENFORCED=false

# Shown on the Terms and Privacy pages. Set to true only after a lawyer has reviewed them.
# NEXT_PUBLIC_LEGAL_ENTITY=
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
# NEXT_PUBLIC_LEGAL_REVIEWED=
