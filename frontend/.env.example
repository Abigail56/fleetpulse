# Server-side only. Do not use the NEXT_PUBLIC_ prefix for this value.
API_BASE_URL=http://localhost:8010

NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
# Optional: a different MapLibre style. The default is OpenFreeMap's dark style, which needs no key.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# Shown on /terms and /privacy. Set them before launch; the pages say what's missing until then.
# NEXT_PUBLIC_LEGAL_ENTITY=
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
# Set to true only after a lawyer has reviewed both pages. Removes the draft notice.
# NEXT_PUBLIC_LEGAL_REVIEWED=
