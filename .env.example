# Copy to .env and replace the placeholders. Never commit .env.

# Docker Compose: local PostGIS container
POSTGRES_DB=fleetpulse
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=replace-with-a-local-password

# Backend (values here must match the POSTGRES_* settings above)
FLEETPULSE_ENVIRONMENT=development
FLEETPULSE_LOG_LEVEL=INFO
# The app connects as a restricted role, so row-level security applies to it.
FLEETPULSE_APP_DB_PASSWORD=replace-with-another-local-password
FLEETPULSE_DATABASE_URL=postgresql+psycopg://fleetpulse_app:replace-with-another-local-password@localhost:5440/fleetpulse
# Only migrations use the owner account.
FLEETPULSE_MIGRATION_DATABASE_URL=postgresql+psycopg://fleetpulse:replace-with-a-local-password@localhost:5440/fleetpulse
FLEETPULSE_REDIS_URL=redis://localhost:6390/0
# JSON list of exact origins. Wildcards are rejected.
FLEETPULSE_CORS_ORIGINS=["http://localhost:3210","http://localhost:3211"]
FLEETPULSE_FRONTEND_BASE_URL=http://localhost:3210

# Signs access tokens and derives CSRF tokens. Generate with: openssl rand -hex 48
FLEETPULSE_JWT_SECRET=replace-with-a-long-random-secret

# Private file storage. These match the local storage container. Any S3-compatible service works.
FLEETPULSE_STORAGE_ENDPOINT_URL=http://localhost:9010
FLEETPULSE_STORAGE_PUBLIC_URL=http://localhost:9010
FLEETPULSE_STORAGE_BUCKET=fleetpulse-files
FLEETPULSE_STORAGE_ACCESS_KEY=fleetpulse-local
FLEETPULSE_STORAGE_SECRET_KEY=fleetpulse-local-secret

# Optional: online payment. Billing stays off until the key is set. See docs/adr/0015-billing.md.
# FLEETPULSE_PAYSTACK_SECRET_KEY=
# FLEETPULSE_BILLING_CURRENCY=USD
# Applies plan limits. Keep this off until customers can actually pay.
# FLEETPULSE_BILLING_ENFORCED=false

# Email. These defaults use the local Mailpit container (inbox at http://localhost:8027).
# Production requires a real provider and FLEETPULSE_SMTP_STARTTLS=true.
FLEETPULSE_SMTP_HOST=localhost
FLEETPULSE_SMTP_PORT=1027
FLEETPULSE_EMAIL_FROM=FleetPulse <no-reply@fleetpulse.local>
# Where website contact form messages go. Required in production.
FLEETPULSE_CONTACT_INBOX_EMAIL=contact@fleetpulse.local
# FLEETPULSE_SMTP_USERNAME=
# FLEETPULSE_SMTP_PASSWORD=
# FLEETPULSE_SMTP_STARTTLS=true

# Optional: Google sign-in. See the README. The button stays hidden until both are set.
# FLEETPULSE_GOOGLE_CLIENT_ID=
# FLEETPULSE_GOOGLE_CLIENT_SECRET=
FLEETPULSE_API_PUBLIC_URL=http://localhost:8010

# Test data only, and always labelled as simulated. Keep this off in production.
FLEETPULSE_GPS_SIMULATOR_ENABLED=true
# Age at which a vehicle's position is shown as stale, then offline. These are the defaults.
# FLEETPULSE_GPS_STALE_MINUTES=15
# FLEETPULSE_GPS_OFFLINE_MINUTES=1440
